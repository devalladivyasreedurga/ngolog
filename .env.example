# Copy to .env (never commit .env). Names verified against the code in backend/app/config.py.

# Database: SQLite works locally; use Postgres on Render.
# DATABASE_URL=postgresql+psycopg://ngolog:ngolog@localhost:5432/ngolog
SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Demo auth (passwordless sign-in). Reviewer role only for these emails.
DEMO_AUTH_ENABLED=true
REVIEWER_EMAILS=reviewer@ngolog.org

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook created for <public backend URL>/api/paypal/webhook, event PAYMENT.CAPTURE.COMPLETED
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Claude. Leave empty to run in manual mode (NGO types claims and receipt totals).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# P1 integrations (not wired yet)
ELASTIC_URL=
ELASTIC_API_KEY=
EMBEDDING_MODEL=
ZAPIER_MCP_SERVER_URL=
ZAPIER_MCP_AUTH_TOKEN=
NOTIFICATION_FROM_EMAIL=

# Frontend (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=   (same sandbox client id; public by design)
