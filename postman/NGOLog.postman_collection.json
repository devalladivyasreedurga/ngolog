{
  "info": {
    "name": "NGOLog",
    "description": "PayPal sandbox calls NGOLog makes, plus its API flow. Fill paypalClientId and paypalClientSecret (sandbox app credentials) and apiBase. Never commit real secrets: keep them in a Postman environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "paypalBase",
      "value": "https://api-m.sandbox.paypal.com"
    },
    {
      "key": "paypalClientId",
      "value": ""
    },
    {
      "key": "paypalClientSecret",
      "value": ""
    },
    {
      "key": "apiBase",
      "value": "http://localhost:8000"
    },
    {
      "key": "campaignId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "PayPal sandbox (direct)",
      "item": [
        {
          "name": "1. Get access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{paypalBase}}/v1/oauth2/token"
            },
            "description": "Sandbox OAuth. Basic auth = PayPal client id and secret (set as collection variables).",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{paypalClientId}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{paypalClientSecret}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token issued', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('paypalToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Create order (what the backend does)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{paypalToken}}"
              },
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paypalBase}}/v2/checkout/orders"
            },
            "description": "Buyer approval cannot be scripted. Open the approve link from this response's links in a browser and pay with a sandbox personal account, then run step 3.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intent\": \"CAPTURE\",\n  \"purchase_units\": [\n    {\n      \"reference_id\": \"postman-demo\",\n      \"custom_id\": \"postman-campaign\",\n      \"description\": \"NGOLog donation (Postman)\",\n      \"amount\": {\n        \"currency_code\": \"USD\",\n        \"value\": \"25.00\"\n      }\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('order created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('paypalOrderId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get order (after buyer approval)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{paypalToken}}"
              }
            ],
            "url": {
              "raw": "{{paypalBase}}/v2/checkout/orders/{{paypalOrderId}}"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('order readable', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "NGOLog API flow",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBase}}/api/health"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('api up', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as demo NGO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiBase}}/api/auth/demo-login"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ngo@brightfutures.org\",\n  \"role\": \"ngo_admin\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('ngoToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as demo donor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiBase}}/api/auth/demo-login"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"donor@example.com\",\n  \"role\": \"donor\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('donorToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "List published campaigns",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBase}}/api/campaigns"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('campaigns listed', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json(); if (c.length) pm.collectionVariables.set('campaignId', c[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create PayPal order for the campaign (donor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiBase}}/api/campaigns/{{campaignId}}/paypal/orders"
            },
            "description": "Approve this order in the PayPal sandbox UI (the Donate button does this), then run the capture request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 25\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{donorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('order created', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('apiOrderId', pm.response.json().paypal_order_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Capture the approved order (donor)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{apiBase}}/api/paypal/orders/{{apiOrderId}}/capture"
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{donorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('captured by the server', () => pm.expect(pm.response.json().status).to.be.oneOf(['captured','completed']));"
                ]
              }
            }
          ]
        },
        {
          "name": "My donations (donor)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBase}}/api/donations/mine"
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{donorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Open a reporting follow-up (NGO, demo trigger)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiBase}}/api/campaigns/{{campaignId}}/reporting-requests/trigger"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cycle_key\": \"postman-1\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ngoToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('thread opened', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('requestId', pm.response.json().request.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Report spending in plain words (NGO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiBase}}/api/reporting-requests/{{requestId}}/messages"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"We bought 25 kits from Demo Stationers for $500 and handed out 20.\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ngoToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('claims proposed', () => pm.expect(pm.response.json().claims.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Accountability console data (NGO)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBase}}/api/accountability"
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ngoToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('console loads', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Public timeline (no sign-in)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBase}}/api/campaigns/{{campaignId}}/timeline"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('timeline public', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
